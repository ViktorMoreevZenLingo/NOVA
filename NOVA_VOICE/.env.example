# Phone assistant function secrets. For local `supabase functions serve`, copy to
# ../supabase/functions/.env.local together with the Alo values from
# ../supabase/functions/.env.example. In production, CI sets them from GitHub secrets.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# Manus API v2 (https://manus.im/app#settings/developers)
MANUS_API_KEY=
# Exact public URL registered with Manus (part of the webhook signature)
MANUS_WEBHOOK_URL=https://<project-ref>.supabase.co/functions/v1/manus-webhook

# Vapi Bearer credential token (Vapi sends "Authorization: Bearer <token>")
VAPI_TOOL_SECRET=
# Caller PIN (6 digits). Callers are matched by their SMS-verified phone in Alo.
TEST_USER_PIN=
# Optional: treat Vapi dashboard web calls as this phone (testing only)
DEMO_WEBCALL_PHONE=

# Shared secret for the pg_cron -> reconcile call (CI generates it per deploy)
CRON_SECRET=
