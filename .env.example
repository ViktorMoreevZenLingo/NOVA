# Copy to supabase/functions/.env for `supabase functions serve`,
# and set in production with: supabase secrets set --env-file <file>
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# Manus API v2 (https://manus.im/app#settings/developers)
MANUS_API_KEY=
# Exact public URL registered with Manus (part of the webhook signature)
MANUS_WEBHOOK_URL=https://<project-ref>.supabase.co/functions/v1/manus-webhook
# Gmail connector UUID from connector.list (Track B)
MANUS_GMAIL_CONNECTOR_ID=9444d960-ab7e-450f-9cb9-b9467fb0adda

# Vapi Bearer credential token (Vapi sends "Authorization: Bearer <token>")
VAPI_TOOL_SECRET=
# Demo caller PIN (6 digits). The caller phone lives in profiles.phone_e164.
TEST_USER_PIN=
# Optional: treat Vapi dashboard web calls as this phone (for testing without a phone)
DEMO_WEBCALL_PHONE=

# Shared secret for the pg_cron -> reconcile call (also stored in Vault as cron_secret)
CRON_SECRET=

# Track B (email notifications)
RESEND_API_KEY=
RESEND_FROM=NOVA <onboarding@resend.dev>
